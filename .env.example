# 兵工铸魂·智绘易学AI思政教学应用软件 V1.0
# 复制为 .env.local 后填写真实值，.env.local 不会被提交到 Git。

# Supabase 项目地址与公开密钥（前端与服务端共用）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# 仅服务端与本地脚本使用，绝不能暴露给浏览器
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key

# AI 服务密钥与固定模型（模型由服务端读取，前端不可指定）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_VL_MODEL=qwen3.7-plus
